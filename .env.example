# Copy to .env (never commit .env). Real environment variables take precedence.
# GOOGLE_API_KEY=your-key   # or GEMINI_API_KEY. Optional: hosted reading/detection (with LIBRARY_ALLOW_HOSTED=1) and voice (with LIBRARY_LIVE_MODEL)
# LIBRARY_ALLOW_HOSTED=0   # 1 lets the 'auto' reader/detector use Gemini when a key is set
# LIBRARY_LIVE_MODEL=      # a Gemini Live model id you have access to (voice); none is assumed
# Optional model/runtime configuration (defaults shown; defaults are not availability/price claims)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MAX_CONCURRENCY=4
# GEMINI_MAX_RETRIES=3
# Thinking-token cap per request for the image stages (spine reading, detection). 'off' = the model's dynamic thinking.
# Measured 2026-10-07: uncapped reads used up to ~19,000 thinking tokens on single crops (YugoTest7) and drained the prepaid credits.
# GEMINI_THINKING_BUDGET=512
# GEMINI_THINKING_BUDGET_STAGES=read,detect
# Optional: set YOUR OWN verified per-million-token rates to get an *estimated* cost in logs.
# Billed cost is otherwise reported as unknown.
# GEMINI_PRICE_IN_PER_MTOK=
# GEMINI_PRICE_OUT_PER_MTOK=
# Optional price/catalogue sources used by later stages
# GOOGLE_BOOKS_API_KEY=
# LIBRARY_CATALOGUE_ONLINE=0
# Independent stage selection. Local detection/OCR do not need Gemini credentials.
# LIBRARY_DETECTOR=auto   # auto | local | gemini | none
# LIBRARY_READER=auto     # auto | rapidocr | easyocr | apple | gemini | none
# LIBRARY_DETECTOR_PYTHON=/absolute/path/to/optional-yolo-venv/bin/python
# LIBRARY_DETECTOR_WEIGHTS=/absolute/path/to/models
# LIBRARY_OCR_RUNTIME_DIR=/absolute/writable/path/to/native-ocr-runtime
# Price HTTP is opt-in; unsupported books remain unknown.
# LIBRARY_PRICING_ONLINE=0
# LIBRARY_READER=easyocr
# LIBRARY_OCR_MAX_BOOKS=4  # per-keyframe OCR budget; remaining crops stay unknown
# LIBRARY_OCR_MODEL_DIR=/absolute/path/to/easyocr_models
# LIBRARY_OCR_PACKAGE_DIR=/absolute/path/to/easyocr_packages
# Open Library: a client that names a contact in its User-Agent may use 3 req/s (anonymous: 1 req/s, the 1.05 s default). Copy these two lines into .env (never commit .env).
# LIBRARY_OL_CONTACT=you@example.com
# LIBRARY_OL_MIN_INTERVAL_S=0.35
# Prices are US/USD only. The Spain/EUR second market (Iberlibro + ECB rate) is off unless LIBRARY_SECOND_MARKET=1.
# LIBRARY_SECOND_MARKET=0
